{
  "name": "bezaleel",
  "productName": "Bezaleel",
  "version": "1.0.0",
  "description": "Editor de video gratis y de código abierto para iglesias y equipos de alabanza",
  "main": "electron/main.js",
  "author": "Ricardo Vega",
  "license": "GPL-3.0-or-later",
  "scripts": {
    "start": "electron .",
    "dist:win": "electron-builder --win nsis --publish never"
  },
  "devDependencies": {
    "electron": "44.5.1",
    "electron-builder": "26.15.3"
  },
  "build": {
    "appId": "org.bezaleel.editor",
    "productName": "Bezaleel",
    "files": [
      "electron/**",
      "app/**",
      "build/icon.png",
      "package.json"
    ],
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "win": {
      "target": "nsis",
      "icon": "build/icon.png",
      "artifactName": "Bezaleel-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Bezaleel"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "ricardiaz97-hub",
        "repo": "Bezaleel"
      }
    ]
  },
  "dependencies": {
    "electron-updater": "6.8.9"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/ricardiaz97-hub/Bezaleel.git"
  }
}
