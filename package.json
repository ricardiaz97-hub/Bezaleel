{
  "name": "arca-estudio",
  "productName": "Arca Estudio",
  "version": "1.0.0",
  "description": "Editor de video para el equipo de medios",
  "main": "electron/main.js",
  "author": "Ricardo Vega",
  "license": "UNLICENSED",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dist:win": "electron-builder --win nsis --publish never"
  },
  "devDependencies": {
    "electron": "44.5.1",
    "electron-builder": "26.15.3"
  },
  "build": {
    "appId": "com.arca.estudio",
    "productName": "Arca Estudio",
    "files": [
      "electron/**",
      "app/**",
      "build/icon.png",
      "package.json"
    ],
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "win": {
      "target": "nsis",
      "icon": "build/icon.png",
      "artifactName": "ArcaEstudio-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Arca Estudio"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "ricardiaz97-hub",
        "repo": "Ricardo-Vega"
      }
    ]
  },
  "dependencies": {
    "electron-updater": "6.8.9"
  }
}
